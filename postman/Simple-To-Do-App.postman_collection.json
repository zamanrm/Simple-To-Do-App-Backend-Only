{
  "info": {
    "_postman_id": "783a2437-2e4d-4817-b364-3a4aa10c1020",
    "name": "Simple To-Do App API",
    "description": "CRUD requests for the Simple To-Do App backend. Run Create first to populate the todoId collection variable.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "todoId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Create todo",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Todo created', function () {",
              "  pm.response.to.have.status(201);",
              "  const body = pm.response.json();",
              "  pm.expect(body.success).to.eql(true);",
              "  pm.collectionVariables.set('todoId', body.data._id);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Postman test todo\",\n  \"description\": \"Created from the Postman collection\",\n  \"completed\": false\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/todos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "todos"
          ]
        }
      }
    },
    {
      "name": "Get all todos",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Todos listed', function () {",
              "  pm.response.to.have.status(200);",
              "  const body = pm.response.json();",
              "  pm.expect(body.success).to.eql(true);",
              "  pm.expect(body.data).to.be.an('array');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/todos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "todos"
          ]
        }
      }
    },
    {
      "name": "Get todo by ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Todo retrieved', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().success).to.eql(true);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/todos/{{todoId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "todos",
            "{{todoId}}"
          ]
        }
      }
    },
    {
      "name": "Update todo",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Todo updated', function () {",
              "  pm.response.to.have.status(200);",
              "  const body = pm.response.json();",
              "  pm.expect(body.success).to.eql(true);",
              "  pm.expect(body.data.completed).to.eql(true);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"completed\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/todos/{{todoId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "todos",
            "{{todoId}}"
          ]
        }
      }
    },
    {
      "name": "Delete todo",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Todo deleted', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().success).to.eql(true);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "url": {
          "raw": "{{baseUrl}}/todos/{{todoId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "todos",
            "{{todoId}}"
          ]
        }
      }
    }
  ]
}
